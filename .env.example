# Stripe (nextlvlpay's own account — settles independently of any merchant's account)
STRIPE_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Shared secret for server-to-server auth with merchant sites (e.g. HelixBio), used in both
# directions: HelixBio -> nextlvlpay (create/status calls) and nextlvlpay -> HelixBio (webhook ping).
# Generate a fresh long random value per environment, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTLVLPAY_API_SECRET=your_shared_secret_min_32_characters

# Comma-separated list of merchant origins allowed as a payment return destination.
ALLOWED_RETURN_ORIGINS=https://helixbiochem.com

# Base URL of the merchant site this nextlvlpay instance's webhook should notify.
HELIXBIO_BASE_URL=https://helixbiochem.com
